# Copy this file to .env (same folder) and fill in your keys.
# .env is gitignored. Never commit it or paste it anywhere.

# LLM key for llm.provider: gemini (default). Free key: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# LLM key for llm.provider: claude. Create one in the Claude Console (platform.claude.com).
# ANTHROPIC_API_KEY=

# Optional. Lets kalbot create a GitHub repo for "submit your GitHub repository link" tasks.
# Fine-grained token (https://github.com/settings/personal-access-tokens) for "All repositories" with
# Administration, Contents and Pages set to "Read and write", or a classic token with the `repo` scope.
# GITHUB_TOKEN=
